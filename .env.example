# UniPhish environment configuration (reference).
#
# UniPhish reads these from the process environment; it does not load a .env file by
# itself. Copy this file to .env, fill in what you need, and export it before running:
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#   uniphish serve
#
# Every variable is optional. Leave secrets empty unless you use that integration, and
# never commit a filled-in .env (it is git-ignored).

# --- Core ------------------------------------------------------------------------
# Where the SQLite verdict store, feed caches and models live (default: ~/.uniphish).
UNIPHISH_DATA_DIR=
# SQLite file (default: $UNIPHISH_DATA_DIR/uniphish.db).
UNIPHISH_DB=
# Enable online enrichment (DNS, RDAP, TLS, ASN, feeds) by default: 1/0 (default 0).
UNIPHISH_ONLINE=0
# Verdict thresholds on the 0..1 risk scale.
UNIPHISH_SUSPICIOUS_THRESHOLD=0.50
UNIPHISH_MALICIOUS_THRESHOLD=0.85
# Outbound HTTP (only used when online).
UNIPHISH_HTTP_TIMEOUT=8
UNIPHISH_HTTP_CONCURRENCY=32
UNIPHISH_HTTP_PER_HOST=4
UNIPHISH_USER_AGENT=

# --- HTTP API (uniphish serve) ----------------------------------------------------
# Comma-separated API keys. EMPTY = unauthenticated developer mode; always set this
# before binding to a non-loopback address. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
UNIPHISH_API_KEYS=
# Comma-separated browser origins allowed by CORS (default: none).
UNIPHISH_CORS_ORIGINS=
# Requests per minute per API key / client IP (0 disables the limiter).
UNIPHISH_RATE_LIMIT=120

# --- Optional third-party enrichment (secrets) ------------------------------------
# Anthropic API key for the LLM analyst narrative (template fallback when unset).
ANTHROPIC_API_KEY=
UNIPHISH_AI_MODEL=claude-sonnet-5-5
# Threat-intel lookups (used only when online).
VT_API_KEY=
URLSCAN_API_KEY=
GSB_API_KEY=
# Optional open-feed credentials (URLhaus, PhishTank).
URLHAUS_AUTH_KEY=
PHISHTANK_APP_KEY=
# Run Playwright detonation without the Chromium sandbox (containers only): 1/0.
UNIPHISH_DETONATE_NO_SANDBOX=

# --- MCP server (uniphish-mcp) ----------------------------------------------------
UNIPHISH_MCP_ONLINE=

# --- Telegram bot (python -m bot.telegram_bot) ------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to use the bot (empty = everyone).
UNIPHISH_BOT_ALLOWED_CHATS=
UNIPHISH_BOT_ONLINE=0
UNIPHISH_BOT_FETCH=0
UNIPHISH_BOT_AI=0
UNIPHISH_BOT_RATE=10
UNIPHISH_BOT_RATE_WINDOW=60
UNIPHISH_BOT_MAX_FILE_BYTES=5000000
UNIPHISH_BOT_CONCURRENCY=4

# --- Evaluation harness -----------------------------------------------------------
UNIPHISH_RESULTS_DIR=
UNIPHISH_CORPUS_DIR=
