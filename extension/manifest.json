{
  "manifest_version": 3,
  "name": "UniPhish — On-device phishing protection",
  "short_name": "UniPhish",
  "version": "2.0.0",
  "description": "Flags phishing links and look-alike (homoglyph/IDN) domains in any language. All scoring runs on your device; nothing is sent anywhere.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "optional_permissions": ["webNavigation"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "UniPhish",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/links.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
