# CT-hunter IOC store (regenerable)
data/iocs/

# Node (web console, extension)
node_modules/
npm-debug.log*

# Local configuration and secrets (see .env.example)
.env
.env.*
!.env.example

# Local databases
*.db
*.sqlite
*.sqlite3

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
